# Canonical origin — the PUBLIC production domain. Drives metadata, canonicals,
# JSON-LD @ids, sitemap.xml and robots.txt. These routes are generated at BUILD
# time, so never put a dev tunnel here: Search Console rejects a sitemap whose
# <loc> host differs from the host serving the sitemap
# ("This URL is not allowed for a Sitemap at this location").
NEXT_PUBLIC_SITE_URL=

# ── Shopify ───────────────────────────────────────────────────────────────
# Permanent myshopify domain
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=

# Storefront API
SHOPIFY_STOREFRONT_API_TOKEN=

# Admin GraphQL API
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Webhooks + internal admin routes (copied from reference for future use).
SHOPIFY_WEBHOOK_SECRET=
SESSION_SECRET=

# ── Internal merchant/diagnostic routes (/api/admin/*) ───────────────────────
ADMIN_API_KEY=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_TEST_EVENT_CODE=

# ── Google Analytics 4 ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_MP_API_SECRET=

# ── Google Tag Manager ────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=

# TikTok Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ── Judge.me (product reviews) ────────────────────────────────────────────
# Private API token — server-only, never exposed to the browser.
# shop_domain reuses SHOPIFY_STORE_DOMAIN above (same store).
JUDGEME_API_TOKEN=
# Which Shopify products belong to this storefront: every active product with this vendor.
# Leave SHOPIFY_PRODUCT_QUERY empty unless you need a custom Admin search.
SHOPIFY_PRODUCT_VENDOR=TheNoelEdit
SHOPIFY_PRODUCT_QUERY=

# Production: private Vercel Blob store so /api/admin/sync can persist the catalog
BLOB_READ_WRITE_TOKEN=
